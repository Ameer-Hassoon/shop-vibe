# SQLite file used by Prisma (created by `npm run db:push`), relative to prisma/schema.prisma
DATABASE_URL="file:./local.db"

# NextAuth. The value below is for local development only.
# Production: generate one with `openssl rand -base64 32`
NEXTAUTH_SECRET="dev-only-secret-change-me"
NEXTAUTH_URL="http://localhost:3000"

# Password for admin@shop.com, created by `npm run db:seed` (demo value; change it anywhere public)
ADMIN_PASSWORD="admin12345"

# Optional: order confirmation emails (https://resend.com). Emails are skipped when empty.
RESEND_API_KEY=""

# Optional: set to "true" only when the app runs behind exactly one reverse proxy that appends
# to X-Forwarded-For. Used for per-client rate limiting of login/register; otherwise all clients
# share one bucket.
TRUST_PROXY=""
