# PostgreSQL. Locally, `docker compose up -d` starts one that matches these URLs.
# Production (e.g. Neon): DATABASE_URL is the pooled connection string (host contains "-pooler"),
# DIRECT_URL the direct one, used only by `prisma migrate`.
DATABASE_URL="postgresql://shop:shop@localhost:5432/shop"
DIRECT_URL="postgresql://shop:shop@localhost:5432/shop"

# NextAuth. The value below is for local development only.
# Production: generate one with `openssl rand -base64 32`
NEXTAUTH_SECRET="dev-only-secret-change-me"
NEXTAUTH_URL="http://localhost:3000"

# Password for the real admin, admin@shop.com, created by `npm run db:seed`. Keep it private.
# If unset, the seed generates a random one and prints it.
ADMIN_PASSWORD="admin12345"

# Public read-only demo admin. It can open every admin page but cannot change anything, and it
# sees customer details masked. Safe to publish on the live site. Leave empty to disable.
DEMO_ADMIN_EMAIL="demo-admin@shop.com"
DEMO_ADMIN_PASSWORD="demo12345"

# Optional: order confirmation emails (https://resend.com). Emails are skipped when empty.
RESEND_API_KEY=""

# Optional: set to "true" only when the app runs behind exactly one reverse proxy that appends
# to X-Forwarded-For (on Vercel, set it to "true"). Used for per-client rate limiting of login/register; otherwise all clients
# share one bucket.
TRUST_PROXY=""
